# Fourni automatiquement par l'intégration Neon de Vercel (chaîne "pooled").
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Secret exigé pour appeler /api/cron/check (à mettre aussi dans cron-job.org).
# Génère-le avec : openssl rand -hex 32
CRON_SECRET=

# Optionnel : webhook appelé à chaque panne / rétablissement.
ALERT_WEBHOOK_URL=
# Optionnel mais recommandé : secret pour la signature HMAC-SHA256 (en-tête X-M2SG-Signature).
ALERT_WEBHOOK_SECRET=
